@startuml
left to right direction
skinparam packageStyle rectangle
actor "Người dùng" as User
rectangle "Ứng dụng từ điển Anh–Việt" {
  usecase "Xem danh sách từ" as UC1
  usecase "Thêm từ" as UC2
  usecase "Sửa nghĩa" as UC3
  usecase "Xóa từ" as UC4
  usecase "Tra cứu chính xác" as UC5
  usecase "Xem gợi ý tiền tố" as UC6
  usecase "Kiểm tra dữ liệu" as UC7
  usecase "Lưu dữ liệu CSV" as UC8
  usecase "Tải dữ liệu CSV" as UC9
}
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
UC2 ..> UC7 : <<include>>
UC3 ..> UC7 : <<include>>
UC2 ..> UC8 : <<include>>
UC3 ..> UC8 : <<include>>
UC4 ..> UC8 : <<include>>
note right of UC9
  Tự động khi khởi động
end note
@enduml
